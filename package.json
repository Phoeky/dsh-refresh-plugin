{
  "name": "dsh-refresh-plugin",
  "version": "1.0.0",
  "description": "DSH desktop refresh plugin: binds F5 / Ctrl+R to reload the app page (F5 does not work by default in production builds).",
  "license": "MIT",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale",
    "icon.svg"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Phoeky/dsh-refresh.git"
  },
  "homepage": "https://github.com/Phoeky/dsh-refresh",
  "bugs": {
    "url": "https://github.com/Phoeky/dsh-refresh/issues"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "refresh",
    "reload"
  ]
}
